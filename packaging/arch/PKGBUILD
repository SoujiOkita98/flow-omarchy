# Maintainer: SoujiOkita98 <https://github.com/SoujiOkita98>
pkgname=flow-omarchy
pkgver=0.3.0
pkgrel=1
pkgdesc="Small, agent-first AI dictation for Omarchy (based on FreeFlow by Zach Latta)"
arch=('any')
url="https://github.com/SoujiOkita98/flow-omarchy"
license=('MIT')
depends=('bash' 'curl' 'jq' 'perl' 'pipewire' 'wl-clipboard' 'hyprland')
optdepends=('libnotify: notifications outside the Omarchy shell')
checkdepends=('python' 'ffmpeg')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

check() {
  cd "$pkgname-$pkgver"
  test/run.sh
}

package() {
  cd "$pkgname-$pkgver"
  make DESTDIR="$pkgdir" PREFIX=/usr install
}
