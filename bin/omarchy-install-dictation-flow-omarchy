#!/bin/bash

# omarchy:summary=Install and configure Flow for Omarchy dictation

# Works from wherever the repo is: a clone made by `omarchy plugin add` (the
# usual way) or any other git clone. Safe to run again.

set -e

root=$(dirname "$(dirname "$(readlink -f "$0")")")
plugin_id=$(jq -r .id "$root/manifest.json")
plugins_dir="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins"

# Put the commands on PATH unless another install already did.
if omarchy-cmd-missing flow-omarchy; then
  mkdir -p "$HOME/.local/bin"
  for file in "$root"/bin/*; do
    ln -sfn "$file" "$HOME/.local/bin/${file##*/}"
  done
fi

# Asks for the API key (stdin works too; empty keeps a saved key) and tests it.
"$root/bin/flow-omarchy" setup

# The recording pill. `omarchy plugin add` already put the repo in place.
if [[ $root != "$plugins_dir"/* ]]; then
  mkdir -p "$plugins_dir"
  ln -sfn "$root" "$plugins_dir/$plugin_id"
fi
omarchy-shell -q shell rescanPlugins
for _ in $(seq 40); do
  omarchy-plugin-list --json | jq -e --arg id "$plugin_id" 'any(.[]; .id == $id)' >/dev/null && break
  sleep 0.05
done
omarchy-plugin-enable "$plugin_id" >/dev/null

omarchy-dictation-use flow-omarchy
omarchy-restart-hyprctl

ready=$(omarchy-i18n dictation.flowReady)
[[ $ready == dictation.flowReady ]] && ready="Flow Dictation Ready"
omarchy-notification-send -g "$ready" "$(omarchy-i18n dictation.hint)" -t 10000
